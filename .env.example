# ==============================================================================
# AgriRisk Kenya - Environment Configuration Template
# ==============================================================================
# Copy this file to .env and configure for your local or production environment.
# NEVER commit .env with real secrets or sensitive credentials to version control.
# ==============================================================================

# Deployment Environment: development | test | production
APP_ENV=development

# Operational Mode: standard | demo
# In 'demo' mode:
# - Loads static validated snapshot from data/demo/
# - Disables external writes and heavy retraining
# - Displays the demo snapshot date prominently
AGRIRISK_MODE=demo

# Logging verbosity: DEBUG | INFO | WARNING | ERROR | CRITICAL
LOG_LEVEL=INFO

# Database Connection
# Development default uses local SQLite database
DATABASE_URL=sqlite:///data/agririsk.db
# Production PostgreSQL example:
# DATABASE_URL=postgresql://user:password@localhost:5432/agririsk

# FastAPI Microservice Host & Port
API_HOST=0.0.0.0
API_PORT=8000

# Streamlit Dashboard Host & Port
DASHBOARD_PORT=8501

# Model & Data Path Overrides (Optional - defaults to repo structure)
# AGRIRISK_MODELS_DIR=artifacts/models
# AGRIRISK_DATA_DIR=data
